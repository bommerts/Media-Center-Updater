<Window
    x:Class="MediaCenterUpdater.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Media Center Updater">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="Root_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="32,28,32,16" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <!-- App logo, drawn as shapes on a 100x100 grid (same design as Assets\Logo.svg). -->
                <Viewbox Width="52" Height="52" VerticalAlignment="Center">
                    <Canvas Width="100" Height="100">
                        <Rectangle Width="100" Height="100" RadiusX="22" RadiusY="22" Fill="#1E293B" />
                        <Polygon Points="30,24 30,72 70,48" Fill="#F59E0B" Stroke="#F59E0B" StrokeThickness="8" StrokeLineJoin="Round" />
                        <Ellipse Canvas.Left="54" Canvas.Top="54" Width="40" Height="40" Fill="#22C55E" Stroke="#1E293B" StrokeThickness="5" />
                        <Path Data="M74,84 V64 M66,72 L74,64 L82,72" Stroke="White" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
                <StackPanel Spacing="3">
                    <TextBlock Text="Media Center Updater" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Keep your media services up to date." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing x:Name="BusyRing" Width="22" Height="22" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Update scan in progress" />
                <Button x:Name="CheckButton" Content="Check for updates" Click="Check_Click" ToolTipService.ToolTip="Check versions without installing updates." />
                <Button x:Name="InstallButton" Content="Check &amp; install" Style="{StaticResource AccentButtonStyle}" Click="Install_Click" ToolTipService.ToolTip="Check monitored apps and install updates where Automatic install is enabled." />
            </StackPanel>
        </Grid>

        <Pivot Grid.Row="1" Margin="20,0,20,0">
            <PivotItem Header="Updates">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="18" Padding="12,6,12,24">
                        <InfoBar x:Name="SummaryBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="Ready when you are" Message="Check now, or enable a schedule in Settings. Scheduled runs install updates only for apps with Automatic install turned on." />
                        <Grid>
                            <TextBlock Text="Your applications" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="MonitoredText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>

                        <ItemsControl x:Name="ProgramsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,0,0,10">
                                        <Grid ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="240" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="122" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="5">
                                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding VersionText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Message}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Message}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="2" Header="Monitor" OnContent="On" OffContent="Off" IsOn="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" VerticalAlignment="Center" AutomationProperties.Name="{Binding MonitorAccessibleName}" />
                                            <ToggleSwitch Grid.Column="3" Header="Automatic install" OnContent="On" OffContent="Off" IsOn="{Binding AutoInstall, Mode=TwoWay}" IsEnabled="{Binding CanAutoInstall}" VerticalAlignment="Center" AutomationProperties.Name="{Binding InstallAccessibleName}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid>
                            <TextBlock Text="Recent activity" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="Open log folder" HorizontalAlignment="Right" Click="OpenLogs_Click" />
                        </Grid>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="EmptyActivityText" Text="Your checks and update results will appear here." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ItemsControl x:Name="ActivityList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="16" Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Application}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>

            <PivotItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="18" Padding="12,6,12,24" MaxWidth="1000" HorizontalAlignment="Stretch">
                        <TextBlock Text="Make it run your way" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Preferences and automatically found keys save themselves. Use Save connections after entering details by hand." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <StackPanel Spacing="5" Margin="0,0,130,0">
                                        <TextBlock Text="Scheduled updates" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="Check monitored apps and apply their automatic install preferences." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ScheduleToggle" HorizontalAlignment="Right" VerticalAlignment="Center" Toggled="Preference_Changed" AutomationProperties.Name="Enable scheduled updates" />
                                </Grid>
                                <StackPanel x:Name="ScheduleOptions" Orientation="Horizontal" Spacing="20">
                                    <ComboBox x:Name="ScheduleModeBox" Header="Frequency" Width="195" SelectionChanged="Selection_Changed" AutomationProperties.Name="Schedule frequency">
                                        <ComboBoxItem Content="Every few hours" Tag="Interval" />
                                        <ComboBoxItem Content="Once a day" Tag="Daily" />
                                    </ComboBox>
                                    <NumberBox x:Name="IntervalBox" Header="Hours between checks" Minimum="1" Maximum="168" SmallChange="1" LargeChange="6" SpinButtonPlacementMode="Compact" Width="185" ValueChanged="Interval_Changed" AutomationProperties.Name="Hours between checks" />
                                    <TimePicker x:Name="DailyTimePicker" Header="Local time" ClockIdentifier="12HourClock" TimeChanged="DailyTime_Changed" AutomationProperties.Name="Daily update time" />
                                </StackPanel>
                                <TextBlock x:Name="ScheduleDetailText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="The app must be running for scheduled checks. Missed checks run when it is next available. Updates may briefly interrupt playback or downloads unless you turn on Wait while apps are in use below." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Wait while apps are in use" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Automatic installs skip a checked app while it is busy and try again in about 30 minutes. Checking for updates is not affected." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ItemsControl x:Name="UsageList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding WaitWhileInUse, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" Margin="0,0,0,6" AutomationProperties.Name="{Binding UsageAccessibleName}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="{Binding UsageDescription}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Spacing="4" MaxWidth="460" HorizontalAlignment="Left">
                                    <PasswordBox x:Name="PulsarrKeyBox" Header="Pulsarr API key (optional)" PasswordRevealMode="Peek" PasswordChanged="PulsarrKey_Changed" AutomationProperties.Name="Pulsarr API key" />
                                    <TextBlock Text="Only needed if Pulsarr asks you to sign in from this PC. Create a key in Pulsarr's settings. Plex, SABnzbd, Radarr, and Sonarr are checked using the settings already on this PC." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Appearance &amp; background behavior" FontSize="17" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ThemeBox" Header="Color mode" Width="210" VerticalAlignment="Top" SelectionChanged="Theme_Changed" AutomationProperties.Name="Color mode">
                                        <ComboBoxItem Content="Dark" Tag="Dark" />
                                        <ComboBoxItem Content="Light" Tag="Light" />
                                        <ComboBoxItem Content="Use Windows setting" Tag="System" />
                                    </ComboBox>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <ToggleSwitch x:Name="TrayToggle" Header="Keep running in the notification area" Toggled="Preference_Changed" AutomationProperties.Name="Minimize and close to tray" />
                                        <TextBlock Text="Minimize or close the window to hide it. Right-click the tray icon to exit." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <CheckBox x:Name="StartMinimizedBox" Content="Start in the notification area" Click="Preference_Changed" />
                                        <CheckBox x:Name="StartupBox" Content="Start with Windows when I sign in" Click="Startup_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Auto-update" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Keep Media Center Updater itself up to date with new versions from GitHub. Each download is checked against its published checksum before it runs." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <InfoBar x:Name="AppUpdateUnavailableBar" IsOpen="False" IsClosable="False" Severity="Informational" Title="Only for installed copies" Message="Auto-update works when Media Center Updater was installed with its setup program (MediaCenterUpdater-Setup.exe). This copy can still check, then you can download the new version yourself." />
                                <Grid ColumnSpacing="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <ToggleSwitch x:Name="AppUpdateCheckToggle" Header="Check for new versions" Toggled="AppUpdatePreference_Changed" AutomationProperties.Name="Check for new versions of Media Center Updater" />
                                        <TextBlock Text="Checks once a day while the app is running, and tells you when a new version is ready." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <ToggleSwitch x:Name="AppUpdateInstallToggle" Header="Install new versions automatically" Toggled="AppUpdatePreference_Changed" AutomationProperties.Name="Install new versions of Media Center Updater automatically" />
                                        <TextBlock Text="Waits until no app updates are running, then installs and reopens the updater. Your settings are kept." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="AppUpdateCheckButton" Content="Check now" Click="AppUpdateCheck_Click" />
                                    <Button x:Name="AppUpdateInstallButton" Content="Install update" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Click="AppUpdateInstall_Click" />
                                    <ProgressRing x:Name="AppUpdateRing" Width="22" Height="22" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Working on Media Center Updater update" />
                                </StackPanel>
                                <TextBlock x:Name="AppUpdateStatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Radarr &amp; Sonarr connections" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="An API key is like a password that lets this updater check Radarr or Sonarr and ask it to install updates. We look for both keys on this PC when the updater opens and fill in any empty boxes. You usually do not need to enter them yourself." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="If a key is missing or has changed, choose Find API keys again. Found keys are filled in and saved securely for your Windows account. If we cannot find a key, you can copy it from that app's Settings → General → Security page. Plex, SABnzbd, and Pulsarr do not need a key here." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="20" RowSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="RadarrUrlBox" Header="Radarr URL" PlaceholderText="http://localhost:7878" InputScope="Url" AutomationProperties.Name="Radarr server URL" />
                                    <PasswordBox x:Name="RadarrKeyBox" Grid.Column="1" Header="Radarr API key" PasswordRevealMode="Peek" AutomationProperties.Name="Radarr API key" />
                                    <TextBlock x:Name="RadarrKeyStatusText" Grid.Row="1" Grid.ColumnSpan="2" Text="Looking for Radarr's key..." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                                    <TextBox x:Name="SonarrUrlBox" Grid.Row="2" Header="Sonarr URL" PlaceholderText="http://localhost:8989" InputScope="Url" AutomationProperties.Name="Sonarr server URL" />
                                    <PasswordBox x:Name="SonarrKeyBox" Grid.Row="2" Grid.Column="1" Header="Sonarr API key" PasswordRevealMode="Peek" AutomationProperties.Name="Sonarr API key" />
                                    <TextBlock x:Name="SonarrKeyStatusText" Grid.Row="3" Grid.ColumnSpan="2" Text="Looking for Sonarr's key..." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="FindKeysButton" Content="Find API keys again" Click="FindKeys_Click" ToolTipService.ToolTip="Read Radarr and Sonarr's settings on this PC again. Replace keys only when a matching key is found." />
                                    <Button x:Name="SaveConnectionsButton" Content="Save connections" Click="SaveConnections_Click" />
                                    <ProgressRing x:Name="KeySearchRing" Width="22" Height="22" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Looking for API keys and checking Pulsarr setup" />
                                </StackPanel>
                                <TextBlock x:Name="KeySearchStatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="22">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Pulsarr installation" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="For automatic updates, Pulsarr needs its Windows installer and Windows service. A service is a background program that Windows manages, so the installer can stop Pulsarr, update it, and start it again. We check the installation on this PC below; you do not need to reinstall Pulsarr if it already meets this requirement." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <InfoBar x:Name="PulsarrSetupBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="Checking Pulsarr's installation" Message="Checking whether this PC already has the supported setup..." />
                            </StackPanel>
                        </Border>

                        <InfoBar x:Name="AdministratorBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="Administrator access" Message="Installing Windows apps and enabling sign-in startup may require administrator access.">
                            <InfoBar.ActionButton>
                                <Button x:Name="ElevateButton" Content="Restart as administrator" Click="Elevate_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <TextBlock x:Name="SettingsStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="ExitButton" Content="Exit Media Center Updater" HorizontalAlignment="Left" Click="Exit_Click" />
                        <TextBlock x:Name="AppVersionText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

        <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="32,12">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NextRunText" Text="Schedule is off" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="BackgroundText" Grid.Column="1" Text="Close to tray is on" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
